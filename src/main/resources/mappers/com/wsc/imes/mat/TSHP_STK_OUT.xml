<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
============================================================================
파일명: TSHP_STK_OUT.xml
설명: 출고 CRUD 매퍼 (TSHP_STK_OUT 테이블)
원본: ProActive TSHP_STK_OUT.cs
작성일: 2026-03-04
사용화면: MAT05A
============================================================================
-->
<mapper namespace="com.wsc.imes.mat.TSHP_STK_OUT">

    <!--
    ============================================================
    TSHP_STK_OUT_SER3: 출고건 목록 조회 (D1A용)
    용도: MAT05A_SER6 - D1A 불출취소 다이얼로그
    ============================================================
    -->
    <select id="TSHP_STK_OUT_SER3" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tshp_stk_out_ser3(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{sapWoNo, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    TSHP_STK_OUT_SER: 출고건 단건 조회 (존재 확인용)
    용도: MAT05A_INS - 기존 출고건 존재 여부 확인
    ============================================================
    -->
    <select id="TSHP_STK_OUT_SER" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tshp_stk_out_ser(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{stkOutNo, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    TSHP_STK_OUT_INS: 출고건 등록
    용도: MAT05A_INS - 현장불출 시 출고 헤더 생성
    ============================================================
    -->
    <insert id="TSHP_STK_OUT_INS" statementType="CALLABLE" parameterType="params">
        {CALL sp_imes_tshp_stk_out_ins(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{stkOutNo, mode=IN, jdbcType=VARCHAR},
            #{prodCode, mode=IN, jdbcType=VARCHAR},
            #{woNo, mode=IN, jdbcType=VARCHAR},
            #{procCode, mode=IN, jdbcType=VARCHAR},
            #{sapWoNo, mode=IN, jdbcType=VARCHAR},
            #{mrpEmp, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </insert>

    <!--
    ============================================================
    TSHP_STK_OUT_UPD: 출고건 불출율 업데이트
    용도: MAT05A_INS - 불출율 갱신
    ============================================================
    -->
    <update id="TSHP_STK_OUT_UPD" statementType="CALLABLE" parameterType="params">
        {CALL sp_imes_tshp_stk_out_upd(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{stkOutNo, mode=IN, jdbcType=VARCHAR},
            #{outRate, mode=IN, jdbcType=DECIMAL}
        )}
    </update>

    <!--
    ============================================================
    TSHP_STK_OUT_SER2: 출고건 목록 조회 (WO_NO 기준)
    용도: MAT05A_INS/DEL - 불출율 계산 시 해당 WO의 모든 STK_OUT 조회
    추가일: 2026-03-05
    ============================================================
    -->
    <select id="TSHP_STK_OUT_SER2" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tshp_stk_out_ser2(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{woNo, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
