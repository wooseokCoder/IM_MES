<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.imes.common.TSYS_FILELIST_MASTER">

    <!--
        파일 메타정보 조회 (단건)
        - TSYS_FILELIST_MASTER에서 FILE_ID로 파일 메타정보 조회
        - 프로시저: sp_imes_tsys_filelist_master_ser
    -->
    <select id="SER" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tsys_filelist_master_ser(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{fileId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
