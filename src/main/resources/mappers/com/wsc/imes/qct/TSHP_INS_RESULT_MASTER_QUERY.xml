<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
 * ==========================================================================
 * 화면명: QCT08A - 자주검사 현황
 * ==========================================================================
 * 설명: 자주검사 결과 마스터+디테일 조인 조회 매퍼
 *       서버사이드 페이징 지원 (카운트 + LIMIT/OFFSET)
 * 테이블: TSHP_INS_RESULT_MASTER (주), TSHP_WORKORDER, TSHP_INS_RESULT,
 *         TORD_PRODUCT, IF_SAP_SHIPINFO, SYS_USER, LSE_STD_PROC
 * 작성일: 2026-03-17
 * @author 송우석
 * ==========================================================================
-->
<mapper namespace="com.wsc.imes.qct.TSHP_INS_RESULT_MASTER_QUERY">

    <!-- 자주검사 현황 카운트 조회 (페이징용) -->
    <select id="TSHP_INS_RESULT_MASTER_QUERY1_COUNT" parameterType="map" statementType="CALLABLE" resultType="map">
        {CALL sp_imes_tshp_ins_result_master_query1_count(
            #{gsPltCode},
            #{plants},
            #{orderLike},
            #{hogiLike},
            #{modelLike},
            #{procCode}
        )}
    </select>

    <!-- 자주검사 현황 메인 조회 (조립/가공 공용, 페이징) -->
    <select id="TSHP_INS_RESULT_MASTER_QUERY1" parameterType="map" statementType="CALLABLE" resultType="map">
        {CALL sp_imes_tshp_ins_result_master_query1(
            #{gsPltCode},
            #{plants},
            #{orderLike},
            #{hogiLike},
            #{modelLike},
            #{procCode},
            #{offset},
            #{limit}
        )}
    </select>

</mapper>
