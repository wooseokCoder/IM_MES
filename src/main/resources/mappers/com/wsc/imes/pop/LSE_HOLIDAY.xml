<mapper namespace="com.wsc.imes.pop.LSE_HOLIDAY">

    <!--
    ============================================================
    LSE_HOLIDAY_SER: 휴일 목록 조회
    원본: LSE_HOLIDAY.LSE_HOLIDAY_SER()
    용도: POP30B 휴일 목록 조회 (기간 필터)
    ============================================================
    -->
    <select id="LSE_HOLIDAY_SER" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_lse_holiday_ser(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{sDate,     mode=IN, jdbcType=VARCHAR},
            #{eDate,     mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
