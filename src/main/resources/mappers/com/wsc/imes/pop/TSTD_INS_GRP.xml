<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
============================================================================
파일명: TSTD_INS_GRP_POP.xml
설명: 검사그룹 조회 매퍼 (TSTD_INS_GRP 테이블)
원본: ProActive TSTD_INS_GRP.cs
화면: POP30B (단말기 - 가공)
작성일: 2026-03-18
============================================================================
-->
<mapper namespace="com.wsc.imes.pop.TSTD_INS_GRP">

    <!--
    ============================================================
    TSTD_INS_GRP_SER2: 검사그룹 전체 조회
    원본: TSTD_INS_GRP.TSTD_INS_GRP_SER2()
    용도: POP30B 검사그룹 목록 전체 조회
    ============================================================
    -->
    <select id="TSTD_INS_GRP_SER2" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tstd_ins_grp_ser2(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{plants,    mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    TSTD_INS_GRP_QUERY2: 검사그룹 조건 조회
    원본: TSTD_INS_GRP.TSTD_INS_GRP_QUERY2()
    용도: POP30B 사용여부 필터 검사그룹 조회
    ============================================================
    -->
    <select id="TSTD_INS_GRP_QUERY2" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tstd_ins_grp_query2(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{plants,    mode=IN, jdbcType=VARCHAR},
            #{useFlag,   mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    TSTD_INS_GRP_IMG_SER: 검사그룹 이미지 단건 조회 (TO_BASE64)
    용도: POP30B D4A 자주검사 이미지 표시 (QCT05A 패턴 재사용)
    ============================================================
    -->
    <select id="TSTD_INS_GRP_IMG_SER" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tstd_ins_grp_img_ser(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{insGrpCode, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
