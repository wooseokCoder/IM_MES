<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.BatchStatus">

    <!-- ========================================================== -->
    <!--   배치 상태 목록 조회 (페이징, 동적 정렬)                        -->
    <!--   프로시저: sp_batchstatus_search                            -->
    <!-- ========================================================== -->
    <select id="search" resultType="record" parameterType="params" statementType="CALLABLE">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_batchstatus_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobId, mode=IN, jdbcType=VARCHAR},
            #{succFail, mode=IN, jdbcType=VARCHAR},
            #{accTimeBgn, mode=IN, jdbcType=VARCHAR},
            #{accTimeEnd, mode=IN, jdbcType=VARCHAR},
            #{sortStr, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   배치 상태 카운트                                           -->
    <!--   프로시저: sp_batchstatus_search_count                      -->
    <!-- ========================================================== -->
    <select id="searchCount" resultType="int" parameterType="params" statementType="CALLABLE">
        {CALL sp_batchstatus_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobId, mode=IN, jdbcType=VARCHAR},
            #{succFail, mode=IN, jdbcType=VARCHAR},
            #{accTimeBgn, mode=IN, jdbcType=VARCHAR},
            #{accTimeEnd, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   Job ID 목록 조회                                          -->
    <!--   프로시저: sp_batchstatus_get_select_job_id                 -->
    <!-- ========================================================== -->
    <select id="getSelectJobId" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_batchstatus_get_select_job_id(
            #{sysId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
