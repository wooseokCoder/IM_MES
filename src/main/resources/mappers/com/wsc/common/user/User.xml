<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.User">

    <!-- ========================================================== -->
    <!--   사용자 목록 조회 (페이징)                                    -->
    <!-- ========================================================== -->
    <select id="search" resultType="user" parameterType="params" statementType="CALLABLE">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_user_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{userName, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR},
            #{orgAuthCode, mode=IN, jdbcType=VARCHAR},
            #{spcAuthCode, mode=IN, jdbcType=VARCHAR},
            #{comCode, mode=IN, jdbcType=VARCHAR},
            #{comName, mode=IN, jdbcType=VARCHAR},
            #{emplNo, mode=IN, jdbcType=VARCHAR},
            #{deptCode, mode=IN, jdbcType=VARCHAR},
            #{deptName, mode=IN, jdbcType=VARCHAR},
            #{upprDeptCode, mode=IN, jdbcType=VARCHAR},
            #{userTel, mode=IN, jdbcType=VARCHAR},
            #{userHp, mode=IN, jdbcType=VARCHAR},
            #{userMail, mode=IN, jdbcType=VARCHAR},
            #{userRemk, mode=IN, jdbcType=VARCHAR},
            #{useFlag, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER},
            #{sortStr, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   사용자 목록 카운트                                          -->
    <!-- ========================================================== -->
    <select id="searchCount" resultType="int" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{userName, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR},
            #{orgAuthCode, mode=IN, jdbcType=VARCHAR},
            #{spcAuthCode, mode=IN, jdbcType=VARCHAR},
            #{comCode, mode=IN, jdbcType=VARCHAR},
            #{comName, mode=IN, jdbcType=VARCHAR},
            #{emplNo, mode=IN, jdbcType=VARCHAR},
            #{deptCode, mode=IN, jdbcType=VARCHAR},
            #{deptName, mode=IN, jdbcType=VARCHAR},
            #{upprDeptCode, mode=IN, jdbcType=VARCHAR},
            #{userTel, mode=IN, jdbcType=VARCHAR},
            #{userHp, mode=IN, jdbcType=VARCHAR},
            #{userMail, mode=IN, jdbcType=VARCHAR},
            #{userRemk, mode=IN, jdbcType=VARCHAR},
            #{useFlag, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   사용자 단건 조회                                            -->
    <!-- ========================================================== -->
    <select id="select" resultType="user" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_select(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   사용자 등록                                                 -->
    <!-- ========================================================== -->
    <insert id="insert" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_insert(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{userName, mode=IN, jdbcType=VARCHAR},
            #{userPwd, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR},
            #{orgAuthCode, mode=IN, jdbcType=VARCHAR},
            #{spcAuthCode, mode=IN, jdbcType=VARCHAR},
            #{comCode, mode=IN, jdbcType=VARCHAR},
            #{comName, mode=IN, jdbcType=VARCHAR},
            #{emplNo, mode=IN, jdbcType=VARCHAR},
            #{deptCode, mode=IN, jdbcType=VARCHAR},
            #{deptName, mode=IN, jdbcType=VARCHAR},
            #{upprDeptCode, mode=IN, jdbcType=VARCHAR},
            #{userTel, mode=IN, jdbcType=VARCHAR},
            #{userHp, mode=IN, jdbcType=VARCHAR},
            #{userMail, mode=IN, jdbcType=VARCHAR},
            #{userRemk, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </insert>

    <!-- ========================================================== -->
    <!--   사용자 수정                                                 -->
    <!-- ========================================================== -->
    <update id="update" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_update(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{userName, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR},
            #{orgAuthCode, mode=IN, jdbcType=VARCHAR},
            #{spcAuthCode, mode=IN, jdbcType=VARCHAR},
            #{comCode, mode=IN, jdbcType=VARCHAR},
            #{comName, mode=IN, jdbcType=VARCHAR},
            #{emplNo, mode=IN, jdbcType=VARCHAR},
            #{deptCode, mode=IN, jdbcType=VARCHAR},
            #{deptName, mode=IN, jdbcType=VARCHAR},
            #{upprDeptCode, mode=IN, jdbcType=VARCHAR},
            #{userTel, mode=IN, jdbcType=VARCHAR},
            #{userHp, mode=IN, jdbcType=VARCHAR},
            #{userMail, mode=IN, jdbcType=VARCHAR},
            #{userRemk, mode=IN, jdbcType=VARCHAR},
            #{useFlag, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- ========================================================== -->
    <!--   사용자 삭제                                                 -->
    <!-- ========================================================== -->
    <delete id="delete" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_delete(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </delete>

    <!-- ========================================================== -->
    <!--   인증 체크 (비밀번호 확인)                                     -->
    <!-- ========================================================== -->
    <select id="checkPassword" parameterType="params" resultType="string" statementType="CALLABLE">
        {CALL sp_user_check_password(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{userPwd, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   90일 동안 암호를 사용 체크                                    -->
    <!-- ========================================================== -->
    <select id="check90days" parameterType="params" resultType="string" statementType="CALLABLE">
        {CALL sp_user_check_90days(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   Bank User 체크 (기존 프로시저 유지)                          -->
    <!-- ========================================================== -->
    <select id="checkBankUser" parameterType="params" resultType="string">
        CALL sp_get_check_bank_user(#{sysId}, #{userId})
    </select>

    <!-- ========================================================== -->
    <!--   ROOT 메뉴 체크 (기존 프로시저 유지)                          -->
    <!-- ========================================================== -->
    <select id="checkRootMenu" parameterType="params" resultType="string">
        CALL sp_get_check_root_menu(#{sysId}, #{userId})
    </select>

    <!-- ========================================================== -->
    <!--   비밀번호 변경시 변경일시 업데이트                              -->
    <!-- ========================================================== -->
    <update id="updatePassword" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_update_password(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{userPwd, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- ========================================================== -->
    <!--   로그인 실패시 실패카운트 증가                                 -->
    <!-- ========================================================== -->
    <update id="updateFailure" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_update_failure(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- ========================================================== -->
    <!--   로그인 성공시 실패카운트 리셋 및 최종로그인일시 업데이트         -->
    <!-- ========================================================== -->
    <update id="updateSuccess" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_update_success(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- ========================================================== -->
    <!--   사용자 타입 조회                                            -->
    <!-- ========================================================== -->
    <select id="getUserType" resultType="string" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_get_type(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   사용자 그룹 조회                                            -->
    <!-- ========================================================== -->
    <select id="getUserGroup" resultType="string" parameterType="params" statementType="CALLABLE">
        {CALL sp_user_get_group(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   이메일 수신거부 처리 (기존 프로시저 유지)                      -->
    <!-- ========================================================== -->
    <select id="unsubscribeMail" resultType="string" parameterType="params">
        CALL SP_SET_UNSUBSCRIBE_MAIL(#{sysId}, #{userId}, #{type})
    </select>

    <!-- ========================================================== -->
    <!--   전시회 이미지 조회 (기존 프로시저 유지)                        -->
    <!-- ========================================================== -->
    <select id="getExhbnImg" resultType="record" parameterType="params">
        CALL sp_get_exhbn_image(#{code})
    </select>

    <!-- ========================================================== -->
    <!--   전시회 상태 조회 (기존 프로시저 유지)                          -->
    <!-- ========================================================== -->
    <select id="getExhbnStates" resultType="record" parameterType="params">
        CALL sp_get_exhbn_States()
    </select>

    <!-- ========================================================== -->
    <!--   전시회 상태 조회2 (기존 프로시저 유지)                         -->
    <!-- ========================================================== -->
    <select id="getExhbnStates2" resultType="record" parameterType="params">
        CALL sp_get_exhbn_States2(#{COUNTRY})
    </select>

    <!-- ========================================================== -->
    <!--   쿠폰 정보 조회 (기존 프로시저 유지)                           -->
    <!-- ========================================================== -->
    <select id="getCouponInfo" resultType="record" parameterType="params">
        CALL sp_get_exhbn_coupon_info(#{code})
    </select>

    <!-- ========================================================== -->
    <!--   메일 체크 (기존 프로시저 유지)                                -->
    <!-- ========================================================== -->
    <select id="getMailCheck" resultType="record" parameterType="params">
        CALL sp_get_exhbn_mail_check(#{code}, #{email})
    </select>

    <!-- ========================================================== -->
    <!--   고객 정보 저장 (기존 프로시저 유지)                           -->
    <!-- ========================================================== -->
    <select id="saveCustInfo" resultType="record" parameterType="params">
        CALL sp_save_exhbn_cust_info(#{code}, #{fristName}, #{lastName}, #{phone}, #{country}, #{addr}, #{city}, #{states}, #{zipCode}, #{email}, #{couponNo})
    </select>

    <!-- ========================================================== -->
    <!--   쿠폰 카운트 조회 (기존 프로시저 유지)                          -->
    <!-- ========================================================== -->
    <select id="getCouponCnt" resultType="record" parameterType="params">
        CALL sp_get_exhbn_coupon_cnt(#{code})
    </select>

    <!-- ========================================================== -->
    <!--   기존 ID 조회 (기존 프로시저 유지)                             -->
    <!-- ========================================================== -->
    <select id="getSelectOldId" resultType="record" parameterType="params">
        CALL SP_GET_SELECT_OLD_ID(#{sysId}, #{userId})
    </select>

</mapper>
