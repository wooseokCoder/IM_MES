<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.UserSecure">

    <!-- ========================================================== -->
    <!-- 1. 사용자 보안 목록 조회 (페이징) - 프로시저 호출           -->
    <!-- AS-IS: search (SELECT with paging, dynamic sort)           -->
    <!-- ========================================================== -->
    <select id="search" statementType="CALLABLE" resultType="record" parameterType="params">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_usersecure_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{secureKey, mode=IN, jdbcType=VARCHAR},
            #{sortStr, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER}
        )}
    </select>

    <!-- ========================================================== -->
    <!-- 2. 사용자 보안 카운트 - 프로시저 호출                       -->
    <!-- AS-IS: searchCount (SELECT COUNT)                          -->
    <!-- ========================================================== -->
    <select id="searchCount" statementType="CALLABLE" resultType="int" parameterType="params">
        {CALL sp_usersecure_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{secureKey, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!-- 3. 사용자 보안 단건 조회 - 프로시저 호출                    -->
    <!-- AS-IS: select (유효한 보안키 확인 - 미사용, 1일 이내)       -->
    <!-- ========================================================== -->
    <select id="select" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_usersecure_select(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{secureKey, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!-- 4. 사용자 보안 등록 - 프로시저 호출                         -->
    <!-- AS-IS: insert (보안키 신규 등록)                            -->
    <!-- ========================================================== -->
    <insert id="insert" statementType="CALLABLE" parameterType="params">
        {CALL sp_usersecure_insert(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{secureKey, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </insert>

    <!-- ========================================================== -->
    <!-- 5. 사용자 보안 수정 - 프로시저 호출                         -->
    <!-- AS-IS: update (로그인 일시 갱신)                            -->
    <!-- ========================================================== -->
    <update id="update" statementType="CALLABLE" parameterType="params">
        {CALL sp_usersecure_update(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{secureKey, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- ========================================================== -->
    <!-- 6. 사용자 보안 삭제 - 프로시저 호출                         -->
    <!-- AS-IS: delete (보안키 삭제)                                 -->
    <!-- ========================================================== -->
    <delete id="delete" statementType="CALLABLE" parameterType="params">
        {CALL sp_usersecure_delete(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{secureKey, mode=IN, jdbcType=VARCHAR}
        )}
    </delete>

</mapper>
