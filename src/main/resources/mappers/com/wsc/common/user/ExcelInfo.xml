<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.ExcelInfo">

    <!-- ========================================================== -->
    <!--   getSelectExcelGroup - 엑셀 그룹 목록 조회                  -->
    <!-- ========================================================== -->
    <select id="getSelectExcelGroup" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_excelinfo_get_select_excel_group(
            #{sysId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   search - 엑셀 정보 목록 조회 (페이징)                       -->
    <!-- ========================================================== -->
    <select id="search" statementType="CALLABLE" resultType="record" parameterType="params">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_excelinfo_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{s_fileNm, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER},
            #{sortStr, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   searchCount - 엑셀 정보 건수 조회                          -->
    <!-- ========================================================== -->
    <select id="searchCount" statementType="CALLABLE" resultType="int" parameterType="params">
        {CALL sp_excelinfo_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{s_fileNm, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   select - 엑셀 정보 상세 조회                               -->
    <!-- ========================================================== -->
    <select id="select" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_excelinfo_select(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{fileNm, mode=IN, jdbcType=VARCHAR},
            #{seq, mode=IN, jdbcType=INTEGER}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   insert - 엑셀 정보 등록                                    -->
    <!-- ========================================================== -->
    <insert id="insert" statementType="CALLABLE" parameterType="params">
        {CALL sp_excelinfo_insert(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{fileNm, mode=IN, jdbcType=VARCHAR},
            #{viewNo, mode=IN, jdbcType=VARCHAR},
            #{colLvl, mode=IN, jdbcType=VARCHAR},
            #{colVal, mode=IN, jdbcType=VARCHAR},
            #{align, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </insert>

    <!-- ========================================================== -->
    <!--   update - 엑셀 정보 수정                                    -->
    <!-- ========================================================== -->
    <update id="update" statementType="CALLABLE" parameterType="params">
        {CALL sp_excelinfo_update(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{fileNm, mode=IN, jdbcType=VARCHAR},
            #{seq, mode=IN, jdbcType=INTEGER},
            #{viewNo, mode=IN, jdbcType=VARCHAR},
            #{colLvl, mode=IN, jdbcType=VARCHAR},
            #{colVal, mode=IN, jdbcType=VARCHAR},
            #{align, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- ========================================================== -->
    <!--   delete - 엑셀 정보 삭제                                    -->
    <!-- ========================================================== -->
    <delete id="delete" statementType="CALLABLE" parameterType="params">
        {CALL sp_excelinfo_delete(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{fileNm, mode=IN, jdbcType=VARCHAR},
            #{seq, mode=IN, jdbcType=INTEGER}
        )}
    </delete>

</mapper>
