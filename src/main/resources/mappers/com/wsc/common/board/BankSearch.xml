<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.board.BankSearch">

    <!-- ========================================================== -->
    <!--   딜러 검색 (DEAL_MAST) - 프로시저 호출                      -->
    <!-- ========================================================== -->

    <!-- [search] 딜러 목록 조회 (페이징) -->
    <select id="search" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_bank_search_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{DEAL_CODE, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=VARCHAR},
            #{end, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [searchCount] 딜러 카운트 -->
    <select id="searchCount" statementType="CALLABLE" parameterType="params" resultType="int">
        {CALL sp_bank_search_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{DEAL_CODE, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
