<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.sample.Sampleboard">

    <!-- ========================================================== -->
    <!--   Stored Procedure 호출 방식으로 전환                       -->
    <!-- ========================================================== -->

    <!-- 목록 조회 (페이징 포함) -->
    <select id="search" resultType="record" parameterType="params" statementType="CALLABLE">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_sampleboard_search(
            #{sysId},
            #{useFlag},
            #{regiId},
            #{bordTitle},
            #{bordText},
            #{bordType},
            #{bordBgn},
            #{bordEnd},
            #{openType},
            #{searchKey},
            #{searchText},
            #{sortStr},
            #{start},
            #{end}
        )}
    </select>

    <!-- 목록 건수 조회 -->
    <select id="searchCount" resultType="int" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_search_count(
            #{sysId},
            #{useFlag},
            #{regiId},
            #{bordTitle},
            #{bordText},
            #{bordType},
            #{bordBgn},
            #{bordEnd},
            #{openType},
            #{searchKey},
            #{searchText}
        )}
    </select>

    <!-- 단건 조회 -->
    <select id="select" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_select(
            #{sysId},
            #{bordNo},
            #{bordGrup}
        )}
    </select>

    <!-- 등록 -->
    <insert id="insert" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_insert(
            #{sysId},
            #{bordGrup},
            #{bordTitle},
            #{gsUserId},
            #{bordNo, mode=OUT, jdbcType=VARCHAR}
        )}
    </insert>

    <!-- 수정 -->
    <update id="update" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_update(
            #{sysId},
            #{bordNo},
            #{bordGrup},
            #{bordTitle},
            #{gsUserId}
        )}
    </update>

    <!-- 삭제 -->
    <delete id="delete" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_delete(
            #{sysId},
            #{bordNo},
            #{bordGrup}
        )}
    </delete>

    <!-- 목록 재정렬 -->
    <select id="getListReorder" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_list_reorder(#{sysId}, #{gsUserId}, #{WIND_ID}, #{VIEW_ID})}
    </select>

    <!-- 목록 재정렬 기본값 -->
    <select id="getListReorderDefault" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_list_reorder_default(#{sysId}, #{gsUserId}, #{WIND_ID})}
    </select>

    <!-- 목록 재정렬 리스트 -->
    <select id="getListReorderList" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_list_reorder_list(#{sysId}, #{gsUserId}, #{WIND_ID})}
    </select>

    <!-- 엑셀 업로드 검증 -->
    <select id="excelUpload" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_excel_upload(#{sysId}, #{bordTitle}, #{readCnt}, #{regiName}, #{regiDate}, #{chngName}, #{chngDate}, #{gsUserId}, #{v_MSG})}
    </select>

    <!-- 엑셀 업로드 저장 -->
    <select id="excelUpdate" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_sampleboard_excel_update(#{sysId}, #{bordNo}, #{bordTitle}, #{readCnt}, #{regiName}, #{regiDate}, #{chngName}, #{chngDate}, #{gsUserId}, #{bordGrup})}
    </select>

</mapper>

