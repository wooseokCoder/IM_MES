<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.UserLogList">

    <!-- ========================================================== -->
    <!--   사용자 로그 목록 조회 (페이징)                           -->
    <!--   Procedure: sp_userloglist_search                         -->
    <!-- ========================================================== -->
    <select id="search" resultType="record" parameterType="params" statementType="CALLABLE">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_userloglist_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{loginDate, mode=IN, jdbcType=VARCHAR},
            #{clientIp, mode=IN, jdbcType=VARCHAR},
            #{clientName, mode=IN, jdbcType=VARCHAR},
            #{clientAgent, mode=IN, jdbcType=VARCHAR},
            #{progId, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR},
            #{accTimeBgn, mode=IN, jdbcType=VARCHAR},
            #{accTimeEnd, mode=IN, jdbcType=VARCHAR},
            #{sortStr, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   사용자 로그 건수 조회                                    -->
    <!--   Procedure: sp_userloglist_search_count                   -->
    <!-- ========================================================== -->
    <select id="searchCount" resultType="int" parameterType="params" statementType="CALLABLE">
        {CALL sp_userloglist_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{loginDate, mode=IN, jdbcType=VARCHAR},
            #{clientIp, mode=IN, jdbcType=VARCHAR},
            #{clientName, mode=IN, jdbcType=VARCHAR},
            #{clientAgent, mode=IN, jdbcType=VARCHAR},
            #{progId, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR},
            #{accTimeBgn, mode=IN, jdbcType=VARCHAR},
            #{accTimeEnd, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   사용자 로그 등록                                         -->
    <!--   기존 프로시저 유지: sp_insert_sys_ulog                    -->
    <!-- ========================================================== -->
    <insert id="insert" parameterType="params">
        CALL sp_insert_sys_ulog(#{sysId}, #{userId}, #{progId}, DATE_FORMAT(NOW(),'%Y%m%d'), #{clientIp}, #{clientName}, #{clientAgent}, #{logRemk})
    </insert>

    <!-- ========================================================== -->
    <!--   사용자 로그 삭제                                         -->
    <!--   Procedure: sp_userloglist_delete                         -->
    <!-- ========================================================== -->
    <delete id="delete" parameterType="params" statementType="CALLABLE">
        {CALL sp_userloglist_delete(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{progId, mode=IN, jdbcType=VARCHAR}
        )}
    </delete>

    <!-- ========================================================== -->
    <!--   사용자 타입 조회                                         -->
    <!--   Procedure: sp_userloglist_get_user_type1                 -->
    <!-- ========================================================== -->
    <select id="getUserType1" resultType="record" parameterType="params" statementType="CALLABLE">
        {CALL sp_userloglist_get_user_type1(
            #{sysId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
