<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
============================================================================
파일명: SysConfig.xml
설명: 시스템 설정 매퍼 (TSYS_CONF)
원본: ProActive acSysConfig.cs
작성일: 2026-03-04
============================================================================
-->
<mapper namespace="com.wsc.imes.common.SysConfig">

    <!--
    ============================================================
    search: 공장코드별 시스템 설정 전체 조회
    AS-IS: MAINFORM_INIT_SYSTEM → SYS_CONF DataTable
    파라미터: gsPltCode - 공장코드
    ============================================================
    -->
    <select id="search" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tsys_conf_search(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
