<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.Password">

    <!-- 사용자 비밀번호 변경 (관리자용) -->
    <update id="updateUserPw" parameterType="params" statementType="CALLABLE">
        {CALL sp_password_update_user_pw(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{newPw, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- 사용자 비밀번호 확인 -->
    <select id="chkUserPw" parameterType="params" resultType="record" statementType="CALLABLE">
        {CALL sp_password_chk_user_pw(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR},
            #{oldPw, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- 사용자 비밀번호 확인2 (함수 포함) -->
    <select id="chkUserPw2" parameterType="params" resultType="record" statementType="CALLABLE">
        {CALL sp_password_chk_user_pw2(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR},
            #{oldPw, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- 사용자 비밀번호 변경 (사용자용) -->
    <update id="updateUserPw-user" parameterType="params" statementType="CALLABLE">
        {CALL sp_password_update_user_pw_user(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR},
            #{newPw, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- 이메일 확인 및 신규 비밀번호 생성 -->
    <select id="emailCheck" parameterType="params" resultType="record" statementType="CALLABLE">
        {CALL sp_password_email_check(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{email, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- 사용자 문자 확인 (로그인 ID 검증) -->
    <select id="chkUserChar" parameterType="params" resultType="record" statementType="CALLABLE">
        {CALL sp_password_chk_user_char(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- 로그인 실패시 실패카운트 증가 -->
    <update id="updateLoginNG" parameterType="params" statementType="CALLABLE">
        {CALL sp_password_update_login_ng(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- 로그인 성공시 실패카운트 리셋 및 최종로그인일시 업데이트 -->
    <update id="updateLoginOK" parameterType="params" statementType="CALLABLE">
        {CALL sp_password_update_login_ok(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- 로그인 상태 확인 -->
    <select id="checkLoginSts" parameterType="params" resultType="record" statementType="CALLABLE">
        {CALL sp_password_check_login_sts(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- 기존 프로시저 유지 -->
    <update id="RejectCheck" parameterType="params">
    	CALL sp_update_gate_pass_reject(#{sysId}, #{bolNo}, #{Reason})
    </update>
</mapper>
