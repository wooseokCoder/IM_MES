    <select id="TSTD_IDLECODE_SER2" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tstd_idlecode_ser2(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{plants, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    TSTD_IDLECODE_SER3: 단건 조회 (IDLE_CODE로)
    원본: TSTD_IDLECODE.TSTD_IDLECODE_SER3()
