            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{idleCode, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    [DEPRECATED] TSTD_IDLECODE_GET_SCODE
    ============================================================
    SCODE 채번은 공통 서비스를 사용합니다:

    @Autowired
    private UtilityService utilityService;

    String scode = utilityService.getSerialNo(gsPltCode, "S");
    // 결과: S260205-0001

    참고: com.wsc.imes.common.UtilityService
    ============================================================
    -->

    <!--
    ============================================================
    TSTD_IDLECODE_INS: 등록
