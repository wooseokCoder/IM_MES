<mapper namespace="com.wsc.imes.std.TSTD_IDLECODE">

    <!--
    ============================================================
    TSTD_IDLECODE_SER: 단건 조회 (SCODE로)
    원본: TSTD_IDLECODE.TSTD_IDLECODE_SER()
    용도: 존재 여부 확인, 상세 조회
    ============================================================
    -->
    <select id="TSTD_IDLECODE_SER" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_imes_tstd_idlecode_ser(
            #{gsPltCode, mode=IN, jdbcType=VARCHAR},
            #{scode, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!--
    ============================================================
    TSTD_IDLECODE_SER2: 사용중인 목록 조회
    원본: TSTD_IDLECODE.TSTD_IDLECODE_SER2()
