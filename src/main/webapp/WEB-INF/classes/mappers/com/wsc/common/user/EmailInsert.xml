<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.user.EmailInsert">

    <!-- 이메일 정보 업데이트 -->
    <update id="EmailInsert" statementType="CALLABLE" parameterType="params">
        {CALL sp_emailinsert_update(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR},
            #{SMTP_MAIL, mode=IN, jdbcType=VARCHAR},
            #{SMTP_PW, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- SMTP 메일 조회 -->
    <select id="gsSmtpMail" statementType="CALLABLE" resultType="String" parameterType="params">
        {CALL sp_emailinsert_get_smtp_mail(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
