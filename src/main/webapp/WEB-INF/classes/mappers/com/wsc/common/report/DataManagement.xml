<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.report.DataManagement">

    <!-- ========================================================== -->
    <!--   1. DATA_OPER_MAST 조회 - 프로시저 호출                    -->
    <!-- ========================================================== -->

    <!-- [search] DATA_OPER_MAST 목록 조회 (페이징) -->
    <!-- gsSorts: List<String>을 bind로 콤마 구분 문자열 생성 후 프로시저에 전달 -->
    <select id="search" statementType="CALLABLE" resultType="record" parameterType="params">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_data_management_search(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{searchJobNo, mode=IN, jdbcType=VARCHAR},
            #{searchDesc, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER},
            #{sortStr, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [searchDetl] DATA_OPER_DETL 목록 조회 (페이징) -->
    <!-- gsSorts: List<String>을 bind로 콤마 구분 문자열 생성 후 프로시저에 전달 -->
    <select id="searchDetl" statementType="CALLABLE" resultType="record" parameterType="params">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_data_management_search_detl(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR},
            #{start, mode=IN, jdbcType=INTEGER},
            #{end, mode=IN, jdbcType=INTEGER},
            #{sortStr, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [searchCount] DATA_OPER_MAST 카운트 -->
    <select id="searchCount" statementType="CALLABLE" resultType="int" parameterType="params">
        {CALL sp_data_management_search_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{searchJobNo, mode=IN, jdbcType=VARCHAR},
            #{searchDesc, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [searchDetlCount] DATA_OPER_DETL 카운트 -->
    <select id="searchDetlCount" statementType="CALLABLE" resultType="int" parameterType="params">
        {CALL sp_data_management_search_detl_count(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [select] DATA_OPER_MAST 단건 조회 -->
    <select id="select" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_select(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [searchAll] DATA_OPER_MAST 전체 조회 -->
    <select id="searchAll" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_select(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [getjobNo] JOB 번호 생성 -->
    <select id="getjobNo" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_get_job_no(
            #{sysId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   2. DATA_OPER_MAST CRUD - 프로시저 호출                    -->
    <!-- ========================================================== -->

    <!-- [DataManagementinsert] DATA_OPER_MAST 등록 -->
    <insert id="DataManagementinsert" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_insert(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobDesc, mode=IN, jdbcType=VARCHAR},
            #{jobType1, mode=IN, jdbcType=VARCHAR},
            #{jobType2, mode=IN, jdbcType=VARCHAR},
            #{authType, mode=IN, jdbcType=VARCHAR},
            #{authGroups, mode=IN, jdbcType=VARCHAR},
            #{authUsers, mode=IN, jdbcType=VARCHAR},
            #{authFunc, mode=IN, jdbcType=VARCHAR},
            #{useYn, mode=IN, jdbcType=VARCHAR},
            #{jobSql, mode=IN, jdbcType=LONGVARCHAR},
            #{remk, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </insert>

    <!-- [DataManagementinsertDetl] DATA_OPER_DETL 등록 -->
    <insert id="DataManagementinsertDetl" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_insert_detl(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR},
            #{parameterCode, mode=IN, jdbcType=VARCHAR},
            #{parameterName, mode=IN, jdbcType=VARCHAR},
            #{parameterSeq, mode=IN, jdbcType=INTEGER},
            #{parameterType, mode=IN, jdbcType=VARCHAR},
            #{parameterLength, mode=IN, jdbcType=INTEGER},
            #{parameterDesc, mode=IN, jdbcType=VARCHAR},
            #{parameterInitVal, mode=IN, jdbcType=VARCHAR},
            #{useYn, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </insert>

    <!-- [DataManagementupdate] DATA_OPER_MAST 수정 -->
    <update id="DataManagementupdate" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_update(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR},
            #{jobDesc, mode=IN, jdbcType=VARCHAR},
            #{jobType1, mode=IN, jdbcType=VARCHAR},
            #{jobType2, mode=IN, jdbcType=VARCHAR},
            #{authType, mode=IN, jdbcType=VARCHAR},
            #{authGroups, mode=IN, jdbcType=VARCHAR},
            #{authUsers, mode=IN, jdbcType=VARCHAR},
            #{authFunc, mode=IN, jdbcType=VARCHAR},
            #{useYn, mode=IN, jdbcType=VARCHAR},
            #{remk, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- [DataManagementupdateDetl] DATA_OPER_DETL 수정 -->
    <update id="DataManagementupdateDetl" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_update_detl(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR},
            #{parameterCode, mode=IN, jdbcType=VARCHAR},
            #{parameterName, mode=IN, jdbcType=VARCHAR},
            #{parameterSeq, mode=IN, jdbcType=INTEGER},
            #{parameterType, mode=IN, jdbcType=VARCHAR},
            #{parameterLength, mode=IN, jdbcType=INTEGER},
            #{parameterDesc, mode=IN, jdbcType=VARCHAR},
            #{parameterInitVal, mode=IN, jdbcType=VARCHAR},
            #{useYn, mode=IN, jdbcType=VARCHAR},
            #{gsUserId, mode=IN, jdbcType=VARCHAR}
        )}
    </update>

    <!-- [updateSql] JOB_SQL 수정 -->
    <update id="updateSql" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_update_sql(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR},
            #{jobSql, mode=IN, jdbcType=LONGVARCHAR}
        )}
    </update>

    <!-- [DataManagementdelete] DATA_OPER_MAST 삭제 -->
    <delete id="DataManagementdelete" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_delete(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR}
        )}
    </delete>

    <!-- [DataManagementdeleteDetl] DATA_OPER_DETL 삭제 -->
    <delete id="DataManagementdeleteDetl" statementType="CALLABLE" parameterType="params">
        {CALL sp_data_management_delete_detl(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{jobNo, mode=IN, jdbcType=VARCHAR},
            #{parameterCode, mode=IN, jdbcType=VARCHAR}
        )}
    </delete>

    <!-- [DataManagementgetFieldTitle] 필드 타이틀 조회 -->
    <!-- gsSorts: List<String>을 bind로 콤마 구분 문자열 생성 후 프로시저에 전달 -->
    <select id="DataManagementgetFieldTitle" statementType="CALLABLE" resultType="record" parameterType="params">
        <bind name="sortStr" value="gsSorts != null and gsSorts.size() > 0 ? @com.wsc.framework.utils.MybatisUtils@join(',', gsSorts) : null" />
        {CALL sp_data_management_get_field_title(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{sortStr, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- ========================================================== -->
    <!--   3. 사용자/그룹 조회 - 프로시저 호출                       -->
    <!-- ========================================================== -->

    <!-- [userType] 사용자 타입 조회 (NOT IN) -->
    <select id="userType" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_user_type(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userType, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [userTypeTarget] 사용자 타입 타겟 조회 (IN) -->
    <select id="userTypeTarget" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_user_type_target(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userTypeTarget, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [groupList] 그룹 목록 조회 (NOT IN) -->
    <select id="groupList" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_group_list(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{group, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [groupTarget] 그룹 타겟 조회 (IN) -->
    <select id="groupTarget" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_group_target(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{groupTarget, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [userIdList] 사용자 ID 목록 조회 (NOT IN) -->
    <select id="userIdList" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_user_id_list(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

    <!-- [userIdTarget] 사용자 ID 타겟 조회 (IN) -->
    <select id="userIdTarget" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL sp_data_management_user_id_target(
            #{sysId, mode=IN, jdbcType=VARCHAR},
            #{userIdTarget, mode=IN, jdbcType=VARCHAR}
        )}
    </select>

</mapper>
