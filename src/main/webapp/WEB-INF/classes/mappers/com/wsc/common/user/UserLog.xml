             )
    </insert>
    -->

    <!-- ========================================================== -->
    <!--   사용자 로그 삭제                                           -->
    <!-- ========================================================== -->
    <delete id="delete" statementType="CALLABLE" parameterType="params">
        {CALL sp_userlog_delete(
            #{sysId,  mode=IN, jdbcType=VARCHAR},
            #{userId, mode=IN, jdbcType=VARCHAR},
            #{progId, mode=IN, jdbcType=VARCHAR}
        )}
    </delete>
    <!-- AS-IS:
    <delete id="delete" parameterType="params">
        DELETE
          FROM SYS_ULOG
         WHERE SYS_ID    = #{sysId}
           AND USER_ID   = #{userId}
           AND PROG_ID   = #{progId}
    </delete>
    -->

</mapper>
