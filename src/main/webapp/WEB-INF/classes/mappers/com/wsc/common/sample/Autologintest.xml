<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.sample.Autologintest">

    <!-- 토큰 생성 (기존 SP_CREATE_TOKEN 프로시저 사용) -->
    <select id="createTokenForTest" statementType="CALLABLE" resultType="record" parameterType="params">
        {CALL SP_CREATE_TOKEN(#{sysId}, #{userId}, #{issuUrl}, #{rqstUrl})}
    </select>

    <!-- URL 경로로 메뉴 키 조회 -->
    <select id="getMenuKeyByUrl" statementType="CALLABLE" resultType="string" parameterType="params">
        {CALL sp_autologintest_get_menu_key_by_url(#{sysId}, #{menuUrl})}
    </select>

</mapper>
