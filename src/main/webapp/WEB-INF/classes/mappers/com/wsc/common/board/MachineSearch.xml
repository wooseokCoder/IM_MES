<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wsc.common.board.MachineSearch">

    <!-- ========================================================== -->
    <!--   설비 검색 (LSE_MACHINE) - acMachineForm 팝업용            -->
    <!-- ========================================================== -->

    <!-- [search] 설비 목록 조회 -->
    <select id="search" statementType="CALLABLE" parameterType="params" resultType="record">
        {CALL sp_machine_search(
            #{pltCode, mode=IN, jdbcType=VARCHAR},
            #{mcLike, mode=IN, jdbcType=VARCHAR},
            #{mcGroup, mode=IN, jdbcType=VARCHAR},
            #{isSap, mode=IN, jdbcType=TINYINT}
        )}
    </select>

</mapper>
