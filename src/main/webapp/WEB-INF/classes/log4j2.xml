<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATH">/mnt/logs/wsc</Property>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d [%t] %p - %C{1}.%M(%L) | %m%n"/>
        </Console>

        <RollingFile name="wscapp"
                     fileName="${LOG_PATH}/wscapp.log"
                     filePattern="${LOG_PATH}/wscapp.%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%5p [%d{yyyy-MM-dd HH:mm:ss}] %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>

        <RollingFile name="wscsql"
                     fileName="${LOG_PATH}/wscsql.log"
                     filePattern="${LOG_PATH}/wscsql.%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%5p [%d{yyyy-MM-dd HH:mm:ss}] %m%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- log4jdbc 설정 -->
        <Logger name="jdbc.sqlonly" level="debug"/>
        <Logger name="net.sf.log4jdbc" level="info" additivity="false"/>

        <!-- Spring Framework 로그 레벨 -->
        <Logger name="org.springframework.core" level="info"/>
        <Logger name="org.springframework.beans" level="warn"/>
        <Logger name="org.springframework.context" level="warn"/>
        <Logger name="org.springframework.web" level="warn"/>

        <!-- 애플리케이션 로그 -->
        <Logger name="com.wsc" level="trace" additivity="false">
            <AppenderRef ref="wscsql"/>
            <AppenderRef ref="console"/>
        </Logger>
<!--         <Logger name="org.apache.jasper.compiler.TldLocationsCache" level="FINE"/> -->
        <Logger name="org.apache.jasper.compiler.TldLocationsCache" level="DEBUG"/>

        <!-- Root Logger -->
        <Root level="warn">
            <AppenderRef ref="console"/>
            <AppenderRef ref="wscapp"/>
        </Root>
    </Loggers>
</Configuration>
